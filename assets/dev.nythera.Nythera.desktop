[Desktop Entry]
Type=Application
Name=Nythera
Comment=A sleek, customizable desktop shell crafted for Wayland.
Exec=nythera --daemon
Icon=nythera
Terminal=false
Categories=Settings;DesktopSettings;
StartupNotify=false
Actions=Settings;
Keywords=desktop;shell;wayland;

[Desktop Action Settings]
Name=Open Settings
Exec=sh -c "nythera msg settings-open || { nythera --daemon && nythera msg settings-open; }"
